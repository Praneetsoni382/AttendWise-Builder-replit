rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health and connection check
    match /test/{docId} {
      allow read: if true;
    }

    // Default deny for unspecified root collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Student user root and all subcollections
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Student's subjects
      match /subjects/{subjectId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Student's timetable
      match /timetableEntries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Student's class sessions
      match /classSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Student's attendance events
      match /attendanceEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Student's photo evidence metadata
      match /evidenceMetadata/{evidenceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
